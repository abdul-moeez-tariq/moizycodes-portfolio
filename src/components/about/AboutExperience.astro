---
const experiences = [
  {
    number: "03",
    role: "Junior Node.js Developer",
    company: "Creation Next Inc.",
    period: "07/2025 – Present",
    location: "Lahore, Pakistan",
    type: "Backend Development",
    description:
      "Developing and maintaining backend services using Node.js, Express.js and MongoDB, with a focus on efficient data handling and API performance. Collaborating with frontend developers to integrate backend functionality with responsive interfaces.",
    technologies: [
      "Node.js",
      "Express.js",
      "MongoDB",
      "REST APIs",
      "HTML",
      "CSS",
      "Bootstrap",
      "Tailwind CSS",
    ],
    status: "Current role",
  },
  {
    number: "02",
    role: "Junior Front-End Developer",
    company: "Creation Next Inc.",
    period: "04/2025 – Present",
    location: "Lahore, Pakistan",
    type: "Frontend Development",
    description:
      "Promoted after successfully completing the internship. Currently contributing to live projects by developing responsive, user-friendly interfaces. Working with cross-functional teams to deliver modern and scalable frontend solutions.",
    technologies: [
      "HTML",
      "CSS",
      "JavaScript",
      "Bootstrap",
      "Tailwind CSS",
      "SASS / LESS",
    ],
    status: "Current role",
  },
  {
    number: "01",
    role: "Front-End Developer Intern",
    company: "Creation Next Inc.",
    period: "01/2025 – 04/2025",
    location: "Lahore, Pakistan",
    type: "Internship",
    description:
      "Completed a three-month internship focused on building responsive user interfaces using HTML, CSS, JavaScript, Bootstrap and Tailwind CSS. Collaborated with the development team on real-world projects, improving website performance and enhancing UI/UX design.",
    technologies: [
      "HTML",
      "CSS",
      "JavaScript",
      "Bootstrap",
      "Tailwind CSS",
    ],
    status: "Completed",
  },
];
---

<section
  id="about-experience"
  aria-labelledby="experience-heading"
  class="experience-section relative mx-auto w-full max-w-[1600px] overflow-hidden px-[8%] py-24 md:px-[6%] max-md:px-[5.5%] max-md:py-20"
>
  <!-- Section heading -->
  <div
    data-experience-reveal
    class="mb-20 flex items-end justify-between gap-12 max-lg:flex-col max-lg:items-center max-lg:text-center max-md:mb-14"
  >
    <div class="max-w-3xl">
      <div class="mb-7 flex items-center gap-4 max-lg:justify-center">
        <span class="h-px w-10 bg-[var(--accent)]"></span>
        <span
          class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--accent)]"
        >
          04 / Where I've Worked
        </span>
      </div>

      <h2
        id="experience-heading"
        class="text-[clamp(3.5rem,8vw,7.5rem)] font-bold uppercase leading-[0.88] tracking-[-0.075em] text-[var(--text)]"
      >
        The work
        <span class="block text-[var(--accent)]">so far.</span>
      </h2>
    </div>

    <p
      class="max-w-md pb-2 font-(--font-primary-family) text-[15px] leading-[1.9] text-[var(--muted)] max-lg:max-w-xl"
    >
      Every role has been a new opportunity to learn, take on responsibility
      and turn practical experience into stronger development skills.
    </p>
  </div>

  <!-- Experience intro -->
  <div
    data-experience-reveal
    class="mb-8 flex items-center justify-between border-y border-[var(--border)] py-5 max-sm:gap-4"
  >
    <span
      class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]"
    >
      Professional experience
    </span>

    <span
      class="text-xs uppercase tracking-[0.16em] text-[var(--accent)]"
    >
      Creation Next Inc.
    </span>
  </div>

  <!-- Timeline -->
  <div class="experience-timeline relative">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute bottom-10 left-[calc(22%+1.5rem)] top-10 w-px bg-[var(--border)] max-lg:left-[1.2rem] max-md:left-[0.85rem]"
    ></div>

    <div class="flex flex-col gap-7">
      {experiences.map((experience) => (
        <article
          data-experience-reveal
          class="experience-entry relative grid grid-cols-[22%_1fr] gap-0 max-lg:grid-cols-[2.5rem_1fr] max-md:grid-cols-[1.8rem_1fr]"
        >
          <!-- Timeline marker and date -->
          <div class="relative flex flex-col items-start pt-9 max-lg:pt-8">
            <span
              class="experience-marker absolute left-[calc(100%-1.5rem)] top-10 z-10 flex h-3 w-3 translate-x-1/2 items-center justify-center rounded-full border-2 border-[var(--accent)] bg-[var(--bg)] shadow-[0_0_0_6px_var(--bg)] transition-[background,transform,box-shadow] duration-500 group-hover:bg-[var(--accent)] max-lg:left-[1.2rem] max-lg:top-9 max-lg:translate-x-[-50%] max-md:left-[0.85rem]"
            ></span>

            <span
              class="font-[var(--font-primary-family)] text-[11px] font-semibold uppercase tracking-[0.16em] text-[var(--accent)] max-lg:hidden"
            >
              {experience.period}
            </span>

            <span
              class="mt-3 max-w-[150px] font-[var(--font-primary-family)] text-xs leading-[1.7] text-[var(--muted)] max-lg:hidden"
            >
              {experience.location}
            </span>
          </div>

          <!-- Experience panel -->
          <div
            class="experience-card group relative isolate overflow-hidden rounded-[1.5rem] border border-[var(--border)] bg-[var(--surface)] transition-[border-color,transform,box-shadow] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] hover:z-10 hover:-translate-y-1 hover:scale-[1.012] hover:border-[var(--accent)] hover:shadow-[0_24px_70px_-35px_color-mix(in_srgb,var(--accent)_45%,transparent)] max-md:rounded-[1.15rem] max-md:hover:translate-y-0 max-md:hover:scale-100"
          >
            <!-- Background number -->
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -right-2 -top-10 z-[-1] select-none font-[var(--font-heading)] text-[clamp(10rem,19vw,17rem)] leading-none tracking-[-0.1em] text-[var(--text)] opacity-[0.035] transition-[opacity,transform,color] duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-[-12px] group-hover:translate-y-2 group-hover:scale-110 group-hover:text-[var(--bg)] group-hover:opacity-[0.13] max-md:right-0 max-md:top-[-1rem] max-md:text-[9rem]"
            >
              {experience.number}
            </span>

            <!-- Inset accent fill -->
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-x-3 inset-y-3 z-[-1] origin-left scale-x-0 rounded-[1.1rem] bg-[var(--accent)] transition-transform duration-[850ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-x-100 max-md:inset-x-2 max-md:inset-y-2 max-md:rounded-[0.9rem]"
            ></div>

            <div
              class="relative p-9 transition-[padding] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:px-11 max-xl:p-8 max-md:p-5 max-md:group-hover:px-5"
            >
              <!-- Top metadata -->
              <div
                class="mb-8 flex flex-wrap items-center justify-between gap-4 max-sm:mb-6"
              >
                <div class="flex flex-wrap items-center gap-3">
                  <span
                    class="rounded-full border border-[var(--border)] px-3 py-1.5 font-[var(--font-primary-family)] text-[9px] font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition-[border-color,color] duration-500 group-hover:border-white/30 group-hover:text-white"
                  >
                    {experience.type}
                  </span>

                  <span
                    class="text-[10px] font-medium uppercase tracking-[0.12em] text-[var(--muted)] transition-colors duration-500 group-hover:text-white/65"
                  >
                    {experience.status}
                  </span>
                </div>

                <span
                  class="text-xs font-medium uppercase tracking-[0.12em] text-[var(--muted)] transition-colors duration-500 group-hover:text-white/65 lg:hidden"
                >
                  {experience.period}
                </span>
              </div>

              <!-- Role and company -->
              <div
                class="flex items-start justify-between gap-8 max-md:flex-col max-md:gap-5"
              >
                <div class="min-w-0">
                  <h3
                    class="max-w-3xl text-[clamp(2.1rem,4.6vw,4.5rem)] font-bold leading-[0.98] tracking-[-0.06em] text-[var(--text)] transition-[color,transform] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-2 group-hover:text-white max-md:text-[clamp(2rem,8vw,3.2rem)] max-md:group-hover:translate-x-0"
                  >
                    {experience.role}
                  </h3>

                  <div
                    class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2"
                  >
                    <span
                      class="font-[var(--font-primary-family)] text-[14px] font-semibold text-[var(--text)] transition-colors duration-500 group-hover:text-white"
                    >
                      {experience.company}
                    </span>

                    <span
                      class="h-1 w-1 rounded-full bg-[var(--accent)] transition-colors duration-500 group-hover:bg-white"
                    ></span>

                    <span
                      class="font-[var(--font-primary-family)] text-[11px] text-[var(--muted)] transition-colors duration-500 group-hover:text-white/65"
                    >
                      {experience.location}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Description -->
              <p
                class="mt-7 max-w-3xl font-[var(--font-primary-family)] text-[13px] leading-[1.95] text-[var(--muted)] transition-colors duration-500 group-hover:text-white/75 max-md:mt-5"
              >
                {experience.description}
              </p>

              <!-- Technologies -->
              <div
                class="mt-8 flex flex-wrap items-center gap-2 border-t border-[var(--border)] pt-6 transition-colors duration-500 group-hover:border-white/20 max-md:mt-6 max-md:pt-5"
              >
                <span
                  class="mr-2 font-[var(--font-primary-family)] text-[9px] font-semibold uppercase tracking-[0.17em] text-[var(--muted)] transition-colors duration-500 group-hover:text-white/55"
                >
                  Technologies
                </span>

                {experience.technologies.map((technology) => (
                  <span
                    class="rounded-full border border-[var(--border)] px-3 py-1.5 font-[var(--font-primary-family)] text-[10px] font-medium text-[var(--text)] transition-[background,border-color,color] duration-500 group-hover:border-white/25 group-hover:bg-white/10 group-hover:text-white"
                  >
                    {technology}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Closing statement -->
  <div
    data-experience-reveal
    class="mt-24 flex items-center justify-between gap-10 border-t border-[var(--border)] pt-8 max-md:mt-16 max-md:flex-col max-md:items-center max-md:text-center"
  >
    <div>
      <span
        class="mb-3 block text-[10px] font-semibold uppercase tracking-[0.2em] text-[var(--accent)]"
      >
        One journey. Continuous growth.
      </span>

      <p
        class="font-(--font-heading) text-[clamp(1.8rem,3.5vw,3.2rem)] leading-[1.05] tracking-[-0.05em] text-[var(--text)]"
      >
        Still learning. Always building.
      </p>
    </div>

    <a
      href="/myJourney"
      class="group/link inline-flex shrink-0 items-center gap-4 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--text)] transition-colors duration-300 hover:text-[var(--accent)]"
    >
      Explore my journey

      <span
        class="flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border)] transition-[transform,background,border-color,color] duration-500 group-hover/link:translate-x-1 group-hover/link:border-[var(--accent)] group-hover/link:bg-[var(--accent)] group-hover/link:text-white"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <path
            d="M5 12H19M19 12L12 5M19 12L12 19"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
    </a>
  </div>
</section>

<script>
  import "../../scripts/about-experience";
</script>
