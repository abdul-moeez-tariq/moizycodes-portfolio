<section
  id="about-cta"
  class="mx-auto w-full max-w-[1600px] px-[8%] pb-28 pt-16 md:px-[6%] max-md:px-[5.5%] max-md:pb-20"
>
  <div
    class="relative overflow-hidden rounded-[28px] border border-[var(--border)] bg-[var(--surface)] px-12 py-16 md:px-16 md:py-20 max-md:px-7 max-md:py-12"
  >
    <span
      class="mb-6 block text-xs uppercase tracking-[0.2em] text-[var(--accent)]"
    >
      What's next?
    </span>

    <h2
      class="max-w-[850px] font-heading text-[clamp(44px,7vw,88px)] leading-[1.02] tracking-[-0.055em] text-[var(--text)]"
    >
      Have an idea?
      <span class="block text-[var(--muted)]"> Let's make it happen. </span>
    </h2>

    <div
      class="mt-12 flex items-center justify-between gap-6 max-sm:flex-col max-sm:items-start"
    >
      <p class="max-w-[370px] text-sm leading-[1.8] text-[var(--muted)]">
        I'm always interested in meaningful ideas and opportunities to build
        something great.
      </p>

      <a
        href="/#contact"
        class="group inline-flex shrink-0 items-center gap-3 rounded-full bg-[var(--text)] px-7 py-4 text-sm font-medium text-[var(--bg)] transition-all duration-300 hover:bg-[var(--accent)] hover:text-white"
      >
        Start a conversation

        <svg
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 10H16M10 4L16 10L10 16"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
