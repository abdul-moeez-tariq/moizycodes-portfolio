
---
---

<section
  id="projects"
  class="projects-hero relative mx-auto mt-20 w-full max-w-[1600px] overflow-hidden px-[7%] py-8 md:px-[6%] max-md:mt-16 max-md:px-[5.5%] max-md:py-6"
>
  <div class="projects-hero-inner">

    <!-- Top Editorial Information -->
    <div
      data-projects-reveal
      class="flex items-center justify-between gap-5 max-md:justify-center"
    >
      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-[var(--accent)]"></span>

        <span
          class="text-xs font-medium uppercase tracking-[0.12em] text-[var(--accent)]"
        >
          Portfolio / Selected Work
        </span>
      </div>

      <span
        class="text-xs font-medium uppercase tracking-[0.14em] text-[var(--muted)] max-md:hidden"
      >
        A collection of digital projects
      </span>
    </div>

    <!-- Main Editorial Heading -->
    <div class="relative mt-16 max-md:mt-12">

      <h1
        class="projects-hero-title font-[var(--font-primary-family)] text-[clamp(64px,13.5vw,172px)] font-bold leading-[0.88] tracking-[-0.07em] text-[var(--text)] max-md:text-center"
      >
        <span data-projects-reveal class="block">
          SELECTED
        </span>

        <span
          data-projects-reveal
          class="block text-[var(--accent)]"
        >
          PROJECTS<span class="text-[var(--text)]">.</span>
        </span>
      </h1>

      <!-- Heading Supporting Detail -->
      <div
        data-projects-reveal
        class="mt-10 flex items-center justify-between gap-5 max-md:justify-center"
      >
        <span
          class="text-xs font-medium uppercase tracking-[0.14em] text-[var(--muted)]"
        >
          Design / Development / Functionality
        </span>

        <span
          class="h-px flex-1 bg-[var(--border)] max-md:hidden"
        ></span>

        <span
          class="text-xs font-medium uppercase tracking-[0.14em] text-[var(--muted)] max-md:hidden"
        >
          Independent Work
        </span>
      </div>
    </div>

    
<!-- Editorial Introduction -->
<div
  class="mt-14 flex items-start justify-between gap-12 border-t border-[var(--border)] pt-8 max-md:mt-10 max-md:flex-col max-md:items-center max-md:gap-5 max-md:pt-6"
>
  <!-- Intro Label -->
  <div
    data-projects-reveal
    class="shrink-0"
  >
    <span
      class="font-[var(--font-primary-family)] text-xs font-medium uppercase tracking-[0.12em] text-[var(--accent)] max-md:text-center"
    >
      Beyond the interface
    </span>
  </div>

  <!-- Description -->
  <div
    data-projects-reveal
    class="w-full max-w-[720px]"
  >
    <p
      class="font-[var(--font-primary-family)] text-base font-normal leading-[1.8] text-[var(--muted)] md:text-lg max-md:text-center"
    >
      Explore a selection of websites and web applications I've built,
      from responsive frontend experiences to full-stack solutions.
      Each project showcases my approach to thoughtful design,
      clean code and practical functionality.
    </p>
  </div>
</div>


  </div>
</section>

