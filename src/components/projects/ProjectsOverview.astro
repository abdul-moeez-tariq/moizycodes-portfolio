
---
const filters = [
  "ALL",
  "HTML & CSS",
  "HTML CSS JS",
  "REACT TAILWINDCSS",
  "FRONTEND",
  "FULL STACK",
  "E-COMMERCE",
  "UI/UX",
];

const projects = [
  {
    number: "01",
    title: "NOVA STUDIO",
    type: "Creative Agency",
    description: "A bold digital experience for a modern creative studio.",
    categories: ["HTML & CSS", "FRONTEND", "UI/UX"],
    stack: ["HTML", "CSS", "JavaScript"],
    visual: "nova",
    accent: "#a78bfa",
    live: "https://example.com",
    caseStudy: "#",
  },
  {
    number: "02",
    title: "CARRY CULTURE",
    type: "E-commerce",
    description: "A refined online shopping experience with a product-first approach.",
    categories: ["HTML CSS JS", "FRONTEND", "E-COMMERCE", "UI/UX"],
    stack: ["HTML", "CSS", "JavaScript"],
    visual: "carry",
    accent: "#d5a77b",
    live: "https://example.com",
    caseStudy: "#",
  },
  {
    number: "03",
    title: "FINORA",
    type: "Finance Dashboard",
    description: "A clear and intuitive interface for managing financial activity.",
    categories: ["REACT TAILWINDCSS", "FRONTEND", "UI/UX"],
    stack: ["React", "Tailwind CSS"],
    visual: "finora",
    accent: "#80b99a",
    live: "https://example.com",
    caseStudy: "#",
  },
  {
    number: "04",
    title: "TASKFLOW",
    type: "Full Stack Application",
    description: "A productivity platform designed to make everyday work simpler.",
    categories: ["REACT TAILWINDCSS", "FRONTEND", "FULL STACK", "UI/UX"],
    stack: ["React", "Tailwind CSS", "Node.js"],
    visual: "taskflow",
    accent: "#a78bfa",
    live: "https://example.com",
    caseStudy: "#",
  },
  {
    number: "05",
    title: "LUMI SKIN",
    type: "Online Store",
    description: "A minimal beauty storefront focused on product discovery.",
    categories: ["HTML & CSS", "HTML CSS JS", "E-COMMERCE", "UI/UX"],
    stack: ["HTML", "CSS", "JavaScript"],
    visual: "lumi",
    accent: "#d99c9c",
    live: "https://example.com",
    caseStudy: "#",
  },
  {
    number: "06",
    title: "DEVSPACE",
    type: "Developer Portfolio",
    description: "An expressive portfolio concept with a strong visual identity.",
    categories: ["REACT TAILWINDCSS", "FRONTEND", "FULL STACK", "UI/UX"],
    stack: ["React", "Tailwind CSS"],
    visual: "devspace",
    accent: "#8c9df4",
    live: "https://example.com",
    caseStudy: "#",
  },
];
---

<section
  id="projects-overview"
  class="projects-overview relative mx-auto w-full max-w-[1600px] px-[7%] pb-28 pt-12 md:px-[6%] max-md:px-[5.5%] max-md:pb-20 max-md:pt-8"
>
  <!-- Section Intro -->
  <div
    data-projects-reveal
    class="flex items-end justify-between gap-8 border-b border-[var(--border)] pb-8 max-md:flex-col max-md:items-center max-md:gap-4 max-md:text-center"
  >
    <div>
      <span class="font-[var(--font-primary-family)] text-xs font-medium uppercase tracking-[0.12em] text-[var(--accent)]">
        01 / The collection
      </span>

      <h2 class="mt-4 font-[var(--font-primary-family)] text-[clamp(38px,5.5vw,76px)] font-bold leading-[0.9] tracking-[-0.075em] text-[var(--text)]">
        SELECTED <span class="text-[var(--muted)]">WORK.</span>
      </h2>
    </div>

    <p class="max-w-[340px] font-[var(--font-primary-family)] text-sm leading-[1.8] text-[var(--muted)] md:text-right">
      A closer look at digital experiences, interfaces and applications built with purpose.
    </p>
  </div>

  <!-- Filters -->
  <div
    data-projects-reveal
    class="mt-9 flex flex-wrap gap-2 max-md:justify-center"
    role="group"
    aria-label="Filter projects"
  >
    {filters.map((filter, index) => (
      <button
        type="button"
        data-project-filter={filter}
        aria-pressed={index === 0 ? "true" : "false"}
        class:list={[
          "projects-filter rounded-full border px-4 py-2.5 font-[var(--font-primary-family)] text-[10px] font-medium uppercase tracking-[0.07em] transition-all duration-300",
          index === 0
            ? "is-active"
            : "border-[var(--border)] text-[var(--muted)] hover:border-[var(--text)] hover:text-[var(--text)]",
        ]}
      >
        {filter}
      </button>
    ))}
  </div>

  <!-- Gallery Meta -->
  <div class="mt-9 flex items-center justify-between border-b border-[var(--border)] pb-4">
    <span class="font-[var(--font-primary-family)] text-[10px] font-medium uppercase tracking-[0.12em] text-[var(--muted)]">
      Selected projects
    </span>
    <span id="projects-count" class="font-[var(--font-primary-family)] text-xs tabular-nums text-[var(--muted)]">
      06 / 06
    </span>
  </div>

  <!-- 3D Project Gallery -->
  <div
    id="projects-grid"
    class="mt-10 grid grid-cols-2 gap-x-7 gap-y-16 max-lg:gap-x-5 max-md:grid-cols-1 max-md:gap-y-12"
  >
    {projects.map((project, index) => (
      <article
        data-project-card
        data-categories={project.categories.join("|")}
        data-project-reveal
        class:list={[
          "project-card group min-w-0",
          index % 2 === 1 ? "md:mt-24" : "",
        ]}
      >
        <!-- 3D Card -->
        <div class="project-card-scene">
          <div
            class="project-card-inner"
            style={`--project-accent:${project.accent}`}
          >
            <!-- Visual Stage -->
            <div class={`project-stage project-stage-${project.visual}`}>
              <div class="project-stage-glow"></div>

              <!-- Browser Frame -->
              <div class="project-browser">
                <div class="project-browser-bar">
                  <div class="project-browser-dots">
                    <i></i><i></i><i></i>
                  </div>
                  <div class="project-browser-address">www.{project.visual}.com</div>
                  <span class="project-browser-menu">•••</span>
                </div>

                <!-- NOVA -->
                {project.visual === "nova" && (
                  <div class="preview-content nova-preview">
                    <div class="preview-nav">
                      <strong>NOVA®</strong>
                      <span>WORK&nbsp;&nbsp; ABOUT&nbsp;&nbsp; CONTACT</span>
                    </div>
                    <div class="nova-main">
                      <span class="preview-eyebrow">CREATIVE DIGITAL STUDIO</span>
                      <div class="nova-heading">MAKE<br />IT <em>MATTER.</em></div>
                      <div class="nova-bottom">
                        <span>Ideas built for a changing world.</span>
                        <span>↗ EXPLORE</span>
                      </div>
                    </div>
                    <div class="nova-orb"></div>
                  </div>
                )}

                <!-- CARRY -->
                {project.visual === "carry" && (
                  <div class="preview-content carry-preview">
                    <div class="preview-nav">
                      <strong>CARRY CULTURE.</strong>
                      <span>SHOP&nbsp;&nbsp; JOURNAL&nbsp;&nbsp; BAG (0)</span>
                    </div>
                    <div class="carry-main">
                      <span class="preview-eyebrow">MADE FOR EVERY DAY</span>
                      <h3>TAKE<br />THE <i>LONG</i><br />WAY.</h3>
                      <div class="carry-products">
                        <div class="carry-product carry-product-one"><span>01</span></div>
                        <div class="carry-product carry-product-two"><span>02</span></div>
                        <div class="carry-product carry-product-three"><span>03</span></div>
                      </div>
                    </div>
                  </div>
                )}

                <!-- FINORA -->
                {project.visual === "finora" && (
                  <div class="preview-content finora-preview">
                    <div class="finora-sidebar">
                      <strong>F.</strong>
                      <span>◫</span><span>▤</span><span>◷</span><span>⚙</span>
                    </div>
                    <div class="finora-main">
                      <div class="finora-top"><strong>Overview</strong><span>•••</span></div>
                      <span class="preview-eyebrow">TOTAL BALANCE</span>
                      <h3>$24,580<span>.00</span></h3>
                      <span class="finora-growth">↗ 12.8% this month</span>
                      <div class="finora-chart">
                        {Array.from({ length: 16 }).map((_, i) => (
                          <i style={`--bar:${22 + ((i * 31 + 13) % 72)}%`}></i>
                        ))}
                      </div>
                      <div class="finora-bottom">
                        <span>MONTHLY ACTIVITY</span><span>VIEW REPORT ↗</span>
                      </div>
                    </div>
                  </div>
                )}

                <!-- TASKFLOW -->
                {project.visual === "taskflow" && (
                  <div class="preview-content task-preview">
                    <div class="task-sidebar">
                      <strong>TASKFLOW.</strong>
                      <span class="task-selected">▦ &nbsp; Overview</span>
                      <span>☷ &nbsp; My tasks</span>
                      <span>◫ &nbsp; Projects</span>
                      <span>⚙ &nbsp; Settings</span>
                    </div>
                    <div class="task-main">
                      <div class="task-heading"><strong>Good morning, Alex.</strong><span>＋ New task</span></div>
                      <div class="task-stats">
                        <div><span>MY TASKS</span><strong>12</strong></div>
                        <div><span>COMPLETED</span><strong>08</strong></div>
                        <div><span>IN PROGRESS</span><strong>04</strong></div>
                      </div>
                      <div class="task-list">
                        <strong>Recent projects</strong>
                        <span><i></i> Website redesign <b>IN PROGRESS</b></span>
                        <span><i></i> Mobile application <b>REVIEW</b></span>
                        <span><i></i> Brand identity <b>COMPLETED</b></span>
                      </div>
                    </div>
                  </div>
                )}

                <!-- LUMI -->
                {project.visual === "lumi" && (
                  <div class="preview-content lumi-preview">
                    <div class="preview-nav">
                      <strong>LUMI SKIN</strong>
                      <span>THE ROUTINE&nbsp;&nbsp; SHOP&nbsp;&nbsp; BAG</span>
                    </div>
                    <div class="lumi-main">
                      <div>
                        <span class="preview-eyebrow">A LITTLE MORE YOU</span>
                        <h3>SKIN<br />IN YOUR<br /><i>OWN</i><br />TERMS.</h3>
                        <span class="lumi-link">DISCOVER THE ROUTINE ↗</span>
                      </div>
                      <div class="lumi-bottle"><span>LUMI<br />SKIN</span></div>
                    </div>
                  </div>
                )}

                <!-- DEVSPACE -->
                {project.visual === "devspace" && (
                  <div class="preview-content dev-preview">
                    <div class="preview-nav">
                      <strong>DEVSPACE®</strong>
                      <span>ABOUT&nbsp;&nbsp; WORK&nbsp;&nbsp; CONTACT</span>
                    </div>
                    <div class="dev-main">
                      <span class="preview-eyebrow">DESIGN-MINDED DEVELOPER</span>
                      <h3>CRAFTING<br />DIGITAL<br /><em>EXPERIENCES.</em></h3>
                      <div class="dev-footer"><span>AVAILABLE FOR SELECT PROJECTS</span><span>LET'S TALK ↗</span></div>
                    </div>
                    <div class="dev-shape"></div>
                  </div>
                )}
              </div>

              <!-- Floating Project Number -->
              <span class="project-floating-number">{project.number}</span>

              <!-- Hover Actions -->
              <div class="project-overlay">
                <a href={project.live} target="_blank" rel="noopener noreferrer" class="project-action">
                  LIVE PREVIEW <span>↗</span>
                </a>
                <a href={project.caseStudy} class="project-action project-action-outline">
                  CASE STUDY <span>↗</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project Details -->
        <div class="project-details">
          <div class="project-details-main">
            <div class="project-meta">
              <span>{project.number}</span>
              <span class="project-meta-line"></span>
              <span>{project.type}</span>
            </div>
            <h3 class="project-title">{project.title}</h3>
            <p class="project-description">{project.description}</p>
            <div class="project-stack">
              {project.stack.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>
          </div>
          <span class="project-detail-arrow">↗</span>
        </div>
      </article>
    ))}
  </div>

  <p id="projects-empty" class="hidden py-20 text-center font-[var(--font-primary-family)] text-sm text-[var(--muted)]">
    No projects found in this category.
  </p>
</section>

<script>
  import "../../scripts/projects-overview";
</script>

<style>
  .projects-filter {
    background: transparent;
    color: var(--muted);
  }

  .projects-filter:hover {
    border-color: var(--text);
    color: var(--text);
  }

  .projects-filter.is-active {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .project-card[hidden] {
    display: none;
  }

  /* 3D card structure */
  .project-card-scene {
    perspective: 1400px;
  }

  .project-card-inner {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 500ms cubic-bezier(.2,.7,.2,1);
    will-change: transform;
  }

  .project-stage {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1.24 / 1;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface);
    transform-style: preserve-3d;
    transition: border-color 400ms ease, box-shadow 400ms ease;
  }

  .project-stage-glow {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 45%, color-mix(in srgb, var(--project-accent) 27%, transparent), transparent 67%),
      var(--surface);
  }

  .project-browser {
    position: absolute;
    inset: 8% 8% 7%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 10px;
    background: #f5f5f2;
    box-shadow: 0 25px 70px rgba(0,0,0,.23);
    transform: translateZ(35px);
    transition: transform 600ms cubic-bezier(.2,.7,.2,1);
  }

  .project-browser-bar {
    height: 27px;
    min-height: 27px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 10px;
    background: #e9e9e7;
    border-bottom: 1px solid #d9d9d6;
  }

  .project-browser-dots {
    display: flex;
    gap: 4px;
  }

  .project-browser-dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #aaa;
  }

  .project-browser-dots i:first-child { background: #ed766d; }
  .project-browser-dots i:nth-child(2) { background: #e6bd5d; }
  .project-browser-dots i:nth-child(3) { background: #6dbb83; }

  .project-browser-address {
    flex: 1;
    max-width: 50%;
    padding: 3px 10px;
    border-radius: 4px;
    background: #f7f7f5;
    color: #858585;
    text-align: center;
    font: 8px Arial, sans-serif;
  }

  .project-browser-menu {
    color: #777;
    font-size: 9px;
  }

  .preview-content {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    padding: 5%;
    font-family: Arial, sans-serif;
  }

  .preview-nav {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: clamp(6px, .8vw, 10px);
  }

  .preview-nav strong {
    font-size: 1.15em;
    letter-spacing: .08em;
  }

  .preview-nav span {
    font-size: .75em;
    letter-spacing: .08em;
  }

  .preview-eyebrow {
    font-size: clamp(6px, .75vw, 9px);
    font-weight: 600;
    letter-spacing: .18em;
  }

  /* NOVA */
  .nova-preview {
    background: #171717;
    color: #f5f3f0;
  }

  .nova-main {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
  }

  .nova-main .preview-eyebrow { color: #b8a4ff; }

  .nova-heading {
    margin-top: 12px;
    font-size: clamp(36px, 6vw, 82px);
    font-weight: 800;
    line-height: .82;
    letter-spacing: -.09em;
  }

  .nova-heading em { color: #b8a4ff; font-style: normal; }

  .nova-bottom {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 18px;
    padding-top: 10px;
    border-top: 1px solid #ffffff30;
    font-size: clamp(6px, .7vw, 9px);
    color: #bcbcbc;
  }

  .nova-orb {
    position: absolute;
    width: 42%;
    aspect-ratio: 1;
    right: -12%;
    top: 24%;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #d7caff, #8467ce 35%, #392b5d 70%);
    filter: blur(1px);
    opacity: .62;
  }

  /* CARRY */
  .carry-preview {
    background: #f1e9df;
    color: #312920;
  }

  .carry-main {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    padding-top: 4%;
  }

  .carry-main h3 {
    position: relative;
    z-index: 2;
    margin-top: 9px;
    font-size: clamp(36px, 6vw, 80px);
    line-height: .8;
    letter-spacing: -.09em;
  }

  .carry-main h3 i { color: #a9794f; }

  .carry-products {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: end;
    gap: 5px;
    height: 58%;
  }

  .carry-product {
    width: clamp(25px, 5vw, 70px);
    height: 75%;
    border-radius: 9px 9px 3px 3px;
    box-shadow: 5px 8px 15px #44301b25;
  }

  .carry-product span {
    display: block;
    margin: 9px;
    font-size: 8px;
    opacity: .6;
  }

  .carry-product-one { background: #c5a68b; transform: rotate(-8deg); }
  .carry-product-two { height: 100%; background: #857362; }
  .carry-product-three { height: 65%; background: #d7c5b2; transform: rotate(8deg); }

  /* FINORA */
  .finora-preview {
    flex-direction: row;
    gap: 5%;
    background: #f1f5f1;
    color: #26372c;
  }

  .finora-sidebar {
    display: flex;
    width: 11%;
    flex-direction: column;
    align-items: center;
    gap: 14%;
    padding-top: 5%;
    border-right: 1px solid #dce5dc;
    color: #708a76;
    font-size: clamp(8px, 1vw, 13px);
  }

  .finora-sidebar strong {
    color: #304d39;
    font-size: 1.5em;
  }

  .finora-main { display: flex; flex: 1; flex-direction: column; min-width: 0; }

  .finora-top, .finora-bottom {
    display: flex;
    justify-content: space-between;
    font-size: clamp(7px, .85vw, 11px);
  }

  .finora-main .preview-eyebrow { margin-top: 9%; color: #7c9381; }

  .finora-main h3 {
    margin-top: 5px;
    font-size: clamp(24px, 4vw, 54px);
    letter-spacing: -.08em;
  }

  .finora-main h3 span { font-size: .55em; }

  .finora-growth { color: #49845c; font-size: clamp(7px, .8vw, 10px); }

  .finora-chart {
    display: flex;
    flex: 1;
    align-items: end;
    gap: 2%;
    margin-top: 8%;
    border-bottom: 1px solid #dce5dc;
  }

  .finora-chart i {
    flex: 1;
    height: var(--bar);
    border-radius: 3px 3px 0 0;
    background: #87b697;
  }

  .finora-bottom { padding-top: 8px; color: #819084; font-size: clamp(6px, .7vw, 9px); }

  /* TASKFLOW */
  .task-preview { flex-direction: row; gap: 4%; background: #f1f1f8; color: #282a3c; }

  .task-sidebar {
    display: flex;
    width: 26%;
    flex-direction: column;
    gap: 13%;
    padding: 5%;
    border-radius: 6px;
    background: #292a43;
    color: #fff;
    font-size: clamp(6px, .75vw, 9px);
  }

  .task-sidebar strong { margin-bottom: 12%; font-size: 1.15em; }

  .task-sidebar .task-selected { color: #c7b6ff; }

  .task-main { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 9%; padding: 2% 0; }

  .task-heading { display: flex; align-items: center; justify-content: space-between; gap: 4px; font-size: clamp(7px, .9vw, 11px); }

  .task-heading span { padding: 5px 7px; border-radius: 4px; background: #7561bd; color: #fff; font-size: .75em; }

  .task-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; }

  .task-stats div { display: flex; flex-direction: column; gap: 5px; padding: 8px 5px; border-radius: 5px; background: white; }

  .task-stats span { color: #9293a1; font-size: clamp(5px, .55vw, 7px); }

  .task-stats strong { font-size: clamp(13px, 2vw, 24px); }

  .task-list { display: flex; flex: 1; flex-direction: column; justify-content: space-around; padding: 8px; border-radius: 5px; background: white; }

  .task-list > strong { font-size: clamp(7px, .8vw, 10px); }

  .task-list span { display: flex; align-items: center; gap: 5px; padding: 5px 0; border-bottom: 1px solid #eee; font-size: clamp(6px, .7vw, 9px); }

  .task-list span i { width: 5px; height: 5px; border-radius: 50%; background: #9a83df; }

  .task-list span b { margin-left: auto; color: #8a7bb9; font-size: .7em; }

  /* LUMI */
  .lumi-preview { background: #f4eae6; color: #4c3a37; }

  .lumi-main { display: flex; flex: 1; align-items: center; justify-content: space-between; gap: 5%; }

  .lumi-main h3 { margin-top: 10px; font-size: clamp(34px, 5.7vw, 75px); line-height: .82; letter-spacing: -.09em; }

  .lumi-main h3 i { color: #b87e7c; }

  .lumi-link { display: inline-block; margin-top: 14px; font-size: clamp(6px, .7vw, 9px); letter-spacing: .1em; }

  .lumi-bottle {
    display: flex;
    width: 30%;
    aspect-ratio: .65;
    align-items: center;
    justify-content: center;
    border: 1px solid #e6d1c8;
    border-radius: 12px 12px 20px 20px;
    background: linear-gradient(110deg, #fff7f1, #d9b8a9 55%, #f4e5dc);
    box-shadow: 10px 20px 30px #78564a25;
    text-align: center;
    font-size: clamp(7px, 1vw, 12px);
    letter-spacing: .12em;
  }

  /* DEVSPACE */
  .dev-preview { background: #15151a; color: #f4f3f7; }

  .dev-main { position: relative; z-index: 2; display: flex; flex: 1; flex-direction: column; justify-content: center; }

