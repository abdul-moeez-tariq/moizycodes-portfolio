<section
  id="home"
  class="hero relative w-full max-w-[1600px] mx-auto px-[8%] pt-16 md:px-[6%] max-md:px-[5.5%] max-md:pt-20"
>
  <!-- Main Title + Button -->
  <div class="relative w-full">
    <h1
      class="m-0 text-[clamp(64px,13.5vw,172px)] font-bold leading-[0.88] tracking-[-0.07em] text-[var(--text)] max-md:text-[clamp(48px,12.8vw,72px)] max-md:leading-[0.91] max-md:text-center"
    >
      <span class="hero-line block translate-y-8 opacity-0"> Full Stack </span>
      <span class="hero-line block translate-y-8 opacity-0 text-[var(--accent)]"> Developer </span>
    </h1>

    <!-- Scroll Button -->
    <a
      href="#projects"
      class="scroll-btn group w-fit absolute top-[53%] right-0 inline-flex items-center gap-2 px-5 py-4 rounded-full bg-[var(--surface)] text-[var(--text)] text-xs font-medium tracking-[0.04em] no-underline whitespace-nowrap translate-y-[-50%] opacity-0 scale-95 transition-all duration-300 ease-out hover:scale-105 max-md:static max-md:translate-y-0 max-md:mt-8 max-md:mx-auto max-md:flex"
    >
      <span> SCROLL DOWN </span>

      <svg
        width="13"
        height="15"
        viewBox="0 0 13 15"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="transition-transform duration-200"
      >
        <g clip-path="url(#clip0_43_1072)">
          <path
            d="M7.02722 12.6657C7.3145 12.3537 7.66169 11.9914 8.05373 11.6103C9.1898 10.5057 10.745 9.20094 12.335 8.53846L12.7196 9.46154C11.3095 10.0491 9.86474 11.2443 8.75081 12.3272C8.1993 12.8634 7.73931 13.3617 7.41747 13.7257C7.25668 13.9076 7.13071 14.0555 7.04541 14.1574C7.00277 14.2083 6.97032 14.2477 6.94878 14.2741L6.92477 14.3036L6.91909 14.3106L6.91785 14.3122L6.52727 14.8004L6.1369 14.3124L6.13545 14.3106L6.12976 14.3036L6.10575 14.2741C6.08422 14.2477 6.05177 14.2083 6.00912 14.1574C5.92383 14.0555 5.79786 13.9076 5.63707 13.7257C5.31523 13.3617 4.85524 12.8634 4.30373 12.3272C3.1898 11.2443 1.74502 10.0491 0.334961 9.46154L0.719576 8.53846C2.30951 9.20094 3.86474 10.5057 5.00081 11.6103C5.39281 11.9914 5.73996 12.3537 6.02722 12.6656V0H7.02722V12.6657Z"
            fill-rule="evenodd"
            clip-rule="evenodd"
            fill="currentColor"
            stroke="currentColor"></path>
        </g>
        <defs>
          <clipPath id="clip0_43_1072">
            <rect width="13" height="15" fill="white"></rect>
          </clipPath>
        </defs>
      </svg>
    </a>
  </div>

  <!-- Bottom Content -->
  <div
    class="mt-14 grid grid-cols-2 gap-10 max-md:mt-11 max-md:grid-cols-1 max-md:gap-7 max-md:text-center max-md:justify-items-center"
  >
    <div class="hero-contact opacity-0 translate-y-4">
      <p class="m-0 mb-1.5 text-sm font-semibold text-[var(--text)]">
        Let's Talk
      </p>
      <a
        href="mailto:moizycodes.dev@gmail.com"
        class="text-sm text-[var(--text)] opacity-80 no-underline transition-opacity duration-200 hover:opacity-100"
      >
        moizycodes.dev@gmail.com
      </a>
    </div>

    <p
      class="hero-desc m-0 max-w-100 justify-self-end text-sm leading-[1.65] text-[var(--text)] opacity-85 max-md:justify-self-center max-md:max-w-full translate-y-4"
    >
      Hello, I'm Abdul Moeez, a creative developer focusing on building modern
      websites, digital products and memorable web experiences.
    </p>
  </div>
</section>

<script>
  function initHeroAnimation() {
    const hero = document.querySelector(".hero");
    if (!hero) return;

    const lines = hero.querySelectorAll(".hero-line");
    const btn = hero.querySelector(".scroll-btn");
    const contact = hero.querySelector(".hero-contact");
    const desc = hero.querySelector(".hero-desc");

    // Reset
    lines.forEach((line) => {
      line.classList.add("opacity-0", "translate-y-8");
    });

    // Animate with delays
    setTimeout(() => {
      lines[0]?.classList.remove("opacity-0", "translate-y-8");
      lines[0]?.classList.add(
        "opacity-100",
        "translate-y-0",
        "transition-all",
        "duration-700",
        "ease-out",
      );
    }, 100);

    setTimeout(() => {
      lines[1]?.classList.remove("opacity-0", "translate-y-8");
      lines[1]?.classList.add(
        "opacity-100",
        "translate-y-0",
        "transition-all",
        "duration-700",
        "ease-out",
      );
    }, 220);

    setTimeout(() => {
      if (btn) {
        btn.classList.remove("opacity-0", "scale-95");
        btn.classList.add("opacity-100", "scale-100");
      }
    }, 380);

    setTimeout(() => {
      contact?.classList.remove("opacity-0", "translate-y-4");
      contact?.classList.add(
        "opacity-100",
        "translate-y-0",
        "transition-all",
        "duration-600",
        "ease-out",
      );

      desc?.classList.remove("opacity-0", "translate-y-4");
      desc?.classList.add(
        "opacity-100",
        "translate-y-0",
        "transition-all",
        "duration-600",
        "ease-out",
      );
    }, 520);
  }

  // Run after page load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroAnimation);
  } else {
    initHeroAnimation();
  }
</script>
