<header class="site-header">
  <a href="/" class="brand-logo" aria-label="MoizyCodes home">
    <img src="/images/logo.png" alt="MoizyCodes Logo" />
  </a>

  <div class="header-actions">
    <ThemeToggle />

    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const menuToggle = document.querySelector("#menu-toggle");

  menuToggle?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("portfolio-menu-toggle"));
  });

  window.addEventListener("portfolio-menu-close", () => {
    menuToggle?.classList.remove("is-open");
    menuToggle?.setAttribute("aria-expanded", "false");
    menuToggle?.setAttribute("aria-label", "Open navigation menu");
  });

  window.addEventListener("portfolio-menu-open", () => {
    menuToggle?.classList.add("is-open");
    menuToggle?.setAttribute("aria-expanded", "true");
    menuToggle?.setAttribute("aria-label", "Close navigation menu");
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 200;
    width: 100%;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 18px;
    background: transparent;
    padding: 0 5%;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .brand-logo img {
    display: block;
    width: auto;
    height: 100px;
    object-fit: contain;
    transition: filter 0.3s ease;
  }

  /* Light mode mein white logo ko dark bana do */
  .brand-logo img {
    filter: invert(1); /* white ko black bana dega */
  }

  /* Dark mode mein normal white rehne do */
  :global(.dark) .brand-logo img,
  :global([data-theme="dark"]) .brand-logo img {
    filter: invert(0);
  }

  .header-actions {
    position: absolute;
    top: 50%;
    right: 5%;
    display: flex;
    align-items: center;
    gap: 12px;
    transform: translateY(-50%);
    z-index: 210;
  }

  .menu-toggle {
    display: none;
    width: 32px;
    height: 32px;
    position: relative;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4.5px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-toggle:hover {
    transform: scale(1.07);
  }

  .menu-toggle span {
    display: block;
    width: 14px;
    height: 1.5px;
    border-radius: 10px;
    background: currentColor;
    transition: all 0.35s cubic-bezier(0.68, -0.55, 0.27, 1.55);
  }

  .menu-toggle span:nth-child(2) {
    width: 10px;
    margin-left: 4px;
  }

  .menu-toggle.is-open span:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle.is-open span:nth-child(2) {
    opacity: 0;
    transform: translateX(8px);
  }

  .menu-toggle.is-open span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ========== Tablet & Mobile ========== */
  @media (max-width: 768px) {
    .site-header {
      height: 56px;
      margin-top: 14px;
      justify-content: space-between; /* Logo left, buttons right */
      padding: 0 5%;
    }

    .brand-logo {
      justify-content: flex-start;
    }

    /* .brand-logo img {
      width: 92px;
    } */

    .header-actions {
      position: static; /* absolute hata diya */
      transform: none;
      right: auto;
      gap: 10px;
    }

    .menu-toggle {
      display: flex;
    }
  }

  @media (max-width: 380px) {
    .site-header {
      padding: 0 4%;
    }

    .brand-logo img {
      /* width: 84px; */
      height: 50px;
    }

    .header-actions {
      gap: 8px;
    }
  }
</style>
