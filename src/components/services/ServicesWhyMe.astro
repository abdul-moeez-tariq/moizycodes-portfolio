
---
const points = [
  "Direct communication throughout the project",
  "Responsive-first development approach",
  "Attention to visual details and usability",
  "Clean and maintainable implementation",
];
---

<section class="mx-auto max-w-[1600px] px-[8%] pb-32 max-lg:px-[6%] max-md:px-[6%] max-md:pb-20">
  <div class="relative overflow-hidden border border-[var(--border)] bg-[var(--surface)] px-12 py-16 max-md:px-6 max-md:py-10">
    <span class="pointer-events-none absolute -right-5 -top-20 font-[var(--font-primary-family)] text-[260px] font-semibold leading-none tracking-[-0.12em] text-[var(--text)] opacity-[0.035] max-md:text-[170px]">M</span>

    <div class="relative grid grid-cols-[1.1fr_0.9fr] gap-16 max-lg:grid-cols-1 max-lg:gap-12">
      <div data-reveal>
        <p class="font-[var(--font-primary-family)] text-[10px] font-semibold uppercase tracking-[0.22em] text-[var(--accent)]">05 / Working together</p>
        <h2 class="mt-8 max-w-[680px] font-[var(--font-heading)] text-[clamp(3.4rem,6vw,6.5rem)] leading-[0.92] tracking-[-0.055em] text-[var(--text)]">
          A developer who cares about the <span class="text-[var(--accent)]">details.</span>
        </h2>
      </div>

      <div class="flex flex-col justify-end" data-reveal>
        <p class="font-[var(--font-primary-family)] text-sm leading-[1.9] text-[var(--muted)]">
          I believe the best work comes from understanding the details, communicating clearly and taking responsibility for the quality of the final experience.
        </p>

        <ul class="mt-9 border-t border-[var(--border)]">
          {points.map((point) => (
            <li class="flex items-start gap-4 border-b border-[var(--border)] py-5">
              <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[var(--accent)] text-white">
                <svg viewBox="0 0 16 16" fill="none" class="h-3 w-3">
                  <path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="font-[var(--font-primary-family)] text-xs leading-[1.8] text-[var(--text)]">{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
