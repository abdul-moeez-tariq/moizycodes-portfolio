---

<section
  id="services"
  class="services-hero relative mx-auto mt-20 w-full max-w-[1600px] overflow-hidden px-[7%] py-8 md:px-[6%] max-md:mt-16 max-md:px-[5.5%] max-md:py-6"
>
  <div class="relative py-12 md:py-16 max-md:py-9">

    <!-- Small section label -->
    <div
      class="mb-8 flex items-center gap-3 md:mb-10 max-md:mb-7"
      data-hero-reveal
    >
      <span class="h-2 w-2 rounded-full bg-[var(--accent)]"></span>

      <span
        class="font-primary text-[11px] font-medium uppercase tracking-[0.16em] text-[var(--muted)] max-md:text-[9px]"
      >
        Services / What I Offer
      </span>
    </div>

    <!-- Main heading: Single H1 -->
    <h1
      class="font-primary text-[clamp(64px,13.5vw,172px)] font-bold uppercase leading-[0.88] tracking-[-0.07em] text-foreground max-md:text-[clamp(48px,14vw,88px)]"
    >
      <span class="block overflow-hidden">
        <span class="block" data-hero-reveal>
          MY
        </span>
      </span>

      <span class="block overflow-hidden">
        <span class="block text-[var(--accent)]" data-hero-reveal>
          SERVICES<span class="text-[var(--text)]">.</span>
        </span>
      </span>
    </h1>

    <!-- Description below heading -->
    <div
      class="mt-9 flex items-end justify-between gap-8 md:mt-12 max-md:mt-7 max-md:flex-col max-md:items-start max-md:gap-6"
    >
     <p
  class="max-w-162.5 font-primary text-[clamp(17px,2vw,24px)] font-medium leading-[1.35] tracking-[-0.035em] text-[var(--muted)]"
  data-hero-reveal
>
  I build modern websites and full-stack applications that combine
  <span class="text-[var(--text)]"> thoughtful design</span>,
  <span class="text-accent"> seamless functionality</span>, and
  real-world performance.
</p>

      <!-- Explore button -->
      
<a
  href="#services-overview"
  class="scroll-btn group inline-flex w-fit items-center gap-2 rounded-full bg-[var(--surface)] px-5 py-4 text-xs font-medium tracking-[0.04em] text-[var(--text)] no-underline whitespace-nowrap transition-all duration-300 ease-out hover:scale-105"
  data-hero-reveal
>
  <span>EXPLORE SERVICES</span>

  <svg
    width="13"
    height="15"
    viewBox="0 0 13 15"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="transition-transform duration-200 group-hover:translate-y-1"
    aria-hidden="true"
  >
    <path
      d="M7.02722 12.6657C7.3145 12.3537 7.66169 11.9914 8.05373 11.6103C9.1898 10.5057 10.745 9.20094 12.335 8.53846L12.7196 9.46154C11.3095 10.0491 9.86474 11.2443 8.75081 12.3272C8.1993 12.8634 7.73931 13.3617 7.41747 13.7257C7.25668 13.9076 7.13071 14.0555 7.04541 14.1574C7.00277 14.2083 6.97032 14.2477 6.94878 14.2741L6.92477 14.3036L6.91909 14.3106L6.91785 14.3122L6.52727 14.8004L6.1369 14.3124L6.13545 14.3106L6.12976 14.3036L6.10575 14.2741C6.08422 14.2477 6.05177 14.2083 6.00912 14.1574C5.92383 14.0555 5.79786 13.9076 5.63707 13.7257C5.31523 13.3617 4.85524 12.8634 4.30373 12.3272C3.1898 11.2443 1.74502 10.0491 0.334961 9.46154L0.719576 8.53846C2.30951 9.20094 3.86474 8.5055 5.00081 11.6103C5.39281 11.9914 5.73996 12.3537 6.02722 12.6656V0H7.02722V12.6657Z"
      fill="currentColor"
      stroke="currentColor"
      fill-rule="evenodd"
      clip-rule="evenodd"
    />
  </svg>
</a>

    </div>

  </div>
</section>

<script>
  import "../../scripts/services-hero.ts";
</script>
