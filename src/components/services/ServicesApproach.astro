
---
const steps = [
  {
    number: "01",
    title: "Discover",
    description:
      "First, I understand your business, your audience and what you want your website to achieve.",
    details: ["Your goals", "Target audience", "Project requirements"],
    outcome: "A clear understanding of your vision.",
  },
  {
    number: "02",
    title: "Plan",
    description:
      "I turn your requirements into a practical direction, defining the structure, features and experience.",
    details: ["Project structure", "Feature planning", "Technical direction"],
    outcome: "A focused plan before development.",
  },
  {
    number: "03",
    title: "Develop",
    description:
      "I build your website with clean code, responsive layouts and functionality designed around your needs.",
    details: ["Responsive development", "Core functionality", "Quality checks"],
    outcome: "A polished and functional website.",
  },
  {
    number: "04",
    title: "Deliver",
    description:
      "Before launch, I test the experience, refine the details and make sure everything is ready to go live.",
    details: ["Final testing", "Performance checks", "Launch support"],
    outcome: "A website ready for your audience.",
  },
];
---

<section
  id="services-approach"
  class="services-approach relative mx-auto mt-20 w-full max-w-[1600px] px-[7%] py-8 md:px-[6%] max-md:mt-16 max-md:px-[5.5%] max-md:py-6"
>
  <div class="relative">
    <!-- Section heading -->
    <div
      class="mb-16 flex items-end justify-between gap-10 max-lg:flex-col max-lg:items-start max-lg:gap-6 max-md:mb-10"
    >
      <div class="max-w-3xl">
        <div
          class="mb-7 flex items-center gap-3 max-md:mb-5"
          data-approach-reveal
        >
          <span class="h-2 w-2 rounded-full bg-[var(--accent)]"></span>
          <span
            class="font-primary text-[11px] font-medium uppercase tracking-[0.16em] text-[var(--muted)] max-md:text-[9px]"
          >
            03 / My Approach
          </span>
        </div>

        <h2
          class="font-primary text-[clamp(48px,8vw,108px)] font-bold uppercase leading-[0.88] tracking-[-0.075em] text-[var(--text)] max-md:text-[clamp(43px,12vw,76px)]"
          data-approach-reveal
        >
          HOW I <span class="text-[var(--accent)]">WORK.</span>
        </h2>
      </div>

      <p
        class="max-w-[390px] pb-2 font-primary text-[clamp(15px,1.35vw,18px)] font-medium leading-[1.5] tracking-[-0.025em] text-[var(--muted)] max-lg:max-w-[540px] max-md:text-[15px]"
        data-approach-reveal
      >
        Every successful project starts with a clear direction. Here's how I
        take an idea from the first conversation to a finished website.
      </p>
    </div>

    <!-- Approach cards -->
    <div
      class="grid grid-cols-4 gap-3 max-lg:grid-cols-2 max-md:grid-cols-1 max-md:gap-3"
    >
      {steps.map((step, index) => (
        <article
          class="approach-card group relative isolate flex min-h-[410px] flex-col overflow-hidden rounded-[1.5rem] border border-[var(--border)] bg-[var(--surface)] p-7 transition-[border-color,transform] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-[var(--accent)] max-lg:min-h-[390px] max-md:min-h-0 max-md:rounded-[1.25rem] max-md:p-6"
          data-approach-card
          data-approach-reveal
          style={`--card-index: ${index};`}
        >
          <!-- Accent hover fill -->
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 -z-10 origin-left scale-x-0 bg-[var(--accent)] transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-x-100"
          ></span>

          <!-- Card top -->
          <div class="relative z-10 flex items-center justify-between">
            <span
              class="font-primary text-xs font-semibold tracking-[0.14em] text-[var(--accent)] transition-colors duration-500 group-hover:text-[var(--bg)]"
            >
              /{step.number}
            </span>

            <span
              class="font-primary text-[10px] font-medium uppercase tracking-[0.13em] text-[var(--muted)] transition-colors duration-500 group-hover:text-[var(--bg)]"
            >
              Step {step.number}
            </span>
          </div>

          <!-- Card content -->
          <div class="relative z-10 mt-auto pt-16 max-md:pt-14">
            <h3
              class="font-[var(--font-heading)] text-[clamp(32px,3.2vw,46px)] font-semibold leading-[0.98] tracking-[-0.055em] text-[var(--text)] transition-colors duration-500 group-hover:text-[var(--bg)] max-md:text-[36px]"
            >
              {step.title}
            </h3>

            <p
              class="mt-5 font-primary text-[13px] font-medium leading-[1.65] tracking-[-0.015em] text-[var(--muted)] transition-colors duration-500 group-hover:text-[var(--bg)] max-md:max-w-[480px]"
            >
              {step.description}
            </p>

            <div
              class="mt-7 flex flex-wrap gap-2"
            >
              {step.details.map((detail) => (
                <span
                  class="rounded-full border border-[var(--border)] px-3 py-2 font-primary text-[10px] font-medium tracking-[0.01em] text-[var(--muted)] transition-[border-color,color] duration-500 group-hover:border-[var(--bg)]/30 group-hover:text-[var(--bg)] max-md:text-[10px]"
                >
                  {detail}
                </span>
              ))}
            </div>
          </div>

          <!-- Card outcome -->
          <div
            class="relative z-10 mt-8 border-t border-[var(--border)] pt-5 transition-colors duration-500 group-hover:border-[var(--bg)]/30"
          >
            <span
              class="font-primary text-[9px] font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition-colors duration-500 group-hover:text-[var(--bg)]"
            >
              THE OUTCOME
            </span>

            <p
              class="mt-2 font-primary text-[12px] font-medium leading-[1.5] text-[var(--text)] transition-colors duration-500 group-hover:text-[var(--bg)]"
            >
              {step.outcome}
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- Closing note -->
    <div
      class="mt-10 flex items-center justify-between gap-6 border-t border-[var(--border)] pt-6 max-md:mt-7 max-md:flex-col max-md:items-start max-md:gap-2"
      data-approach-reveal
    >
      <p
        class="font-primary text-xs font-medium uppercase tracking-[0.13em] text-[var(--muted)]"
      >
        A thoughtful process. A better end result.
      </p>

      <p
        class="font-primary text-xs font-medium uppercase tracking-[0.02em] text-[var(--accent)]"
      >
        From first idea to final launch.
      </p>
    </div>
  </div>
</section>

<script>
  import "../../scripts/services-approach";
</script>
