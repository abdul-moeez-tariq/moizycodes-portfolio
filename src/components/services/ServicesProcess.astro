
---
const steps = [
  {
    number: "01",
    title: "Discover",
    description: "We start by understanding your goals, audience, requirements and the problem the website needs to solve.",
  },
  {
    number: "02",
    title: "Plan",
    description: "The project direction, content structure, functionality and development priorities are defined before implementation.",
  },
  {
    number: "03",
    title: "Build",
    description: "The experience is developed with attention to responsive layouts, interactions, functionality and clean code.",
  },
  {
    number: "04",
    title: "Refine",
    description: "The final experience is reviewed, tested across screen sizes and refined before delivery.",
  },
];
---

<section class="mx-auto max-w-[1600px] px-[8%] py-32 max-lg:px-[6%] max-md:px-[6%] max-md:py-20">
  <div class="flex items-end justify-between gap-10 max-md:flex-col max-md:items-start" data-reveal>
    <div>
      <p class="font-[var(--font-primary-family)] text-[10px] font-semibold uppercase tracking-[0.22em] text-[var(--accent)]">04 / The workflow</p>
      <h2 class="mt-6 font-[var(--font-heading)] text-[clamp(3.5rem,7vw,7rem)] leading-[0.9] tracking-[-0.055em] text-[var(--text)]">
        From idea<br />to <span class="text-[var(--accent)]">reality.</span>
      </h2>
    </div>
    <p class="max-w-[330px] pb-2 font-[var(--font-primary-family)] text-sm leading-[1.9] text-[var(--muted)]">
      A considered process keeps the work focused, transparent and moving in the right direction.
    </p>
  </div>

  <div class="mt-20 grid grid-cols-4 border-y border-[var(--border)] max-lg:grid-cols-2 max-sm:grid-cols-1">
    {steps.map((step, index) => (
      <article class="process-card group relative min-h-[300px] overflow-hidden border-r border-[var(--border)] p-7 transition-colors duration-500 hover:bg-[var(--surface)] last:border-r-0 max-lg:min-h-[260px] max-lg:border-b max-lg:odd:border-r max-lg:even:border-r-0 max-sm:min-h-0 max-sm:border-r-0 max-sm:py-8">
        <span class="pointer-events-none absolute -right-2 -top-12 font-[var(--font-primary-family)] text-[145px] font-semibold leading-none tracking-[-0.1em] text-[var(--text)] opacity-[0.035] transition-all duration-500 group-hover:-translate-y-3 group-hover:text-[var(--accent)] group-hover:opacity-[0.13]">
          {step.number}
        </span>
        <div class="relative flex h-full flex-col justify-between gap-12">
          <div class="flex items-center justify-between">
            <span class="font-[var(--font-primary-family)] text-xs tracking-[0.15em] text-[var(--accent)]">{step.number}</span>
            <span class="h-2 w-2 rounded-full bg-[var(--border)] transition-colors duration-300 group-hover:bg-[var(--accent)]"></span>
          </div>
          <div>
            <h3 class="font-[var(--font-heading)] text-4xl tracking-[-0.04em] text-[var(--text)]">{step.title}</h3>
            <p class="mt-4 font-[var(--font-primary-family)] text-xs leading-[1.9] text-[var(--muted)]">{step.description}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
