---
const testimonials = [
  {
    name: "Muhammad Danish",
    role: "Founder, Quality Logistics",
    initials: "MD",
    quote:
      "Moeez has an incredible eye for detail. He transformed our vision into a digital experience that feels genuinely different. The quality of execution was outstanding.",
    featured: true,
  },
  {
    name: "James Wilson",
    role: "Product Manager",
    initials: "JW",
    quote:
      "An excellent developer with a strong understanding of both design and technology. The entire experience was smooth from start to finish.",
  },
  {
    name: "Sarah Mitchell",
    role: "Business Owner",
    initials: "SM",
    quote:
      "The attention to detail, performance and overall quality exceeded our expectations. Everything feels considered and beautifully executed.",
  },
];
---

<section
  id="testimonials"
  class="testimonials mx-auto w-full max-w-[1600px] px-[8%] mt-16 md:mt-20 lg:mt-28 md:px-[6%] max-md:px-[5.5%]"
>
  <div
    data-review-reveal
    class="flex items-end justify-between gap-8 max-md:mb-10 max-md:flex-col max-md:items-start"
  >
    <div>
      <p class="mb-5 text-xs font-medium text-[var(--accent)]">
        What people say?
      </p>

      <h2
        class="text-[clamp(54px,9vw,116px)] font-bold uppercase leading-[0.84] tracking-[-0.08em] text-[var(--text)]"
      >
        Kind words<span class="text-[var(--accent)]">.</span>
      </h2>
    </div>

    <p class="m-0 max-w-70 text-sm leading-[1.8] text-[var(--muted)]">
      Great collaborations leave a lasting impression. Here's what clients have
      to say.
    </p>
  </div>

  <div class="mt-10 grid grid-cols-12 gap-5 max-md:grid-cols-1">
    <!-- Featured testimonial -->
    <article
      data-review-reveal
      class="group relative col-span-7 flex min-h-[490px] flex-col justify-between overflow-hidden rounded-[24px] bg-[var(--surface)] p-10 transition-transform duration-500 hover:-translate-y-1 max-lg:col-span-6 max-md:min-h-100 max-md:p-7"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-[var(--accent)] opacity-[0.09] blur-[90px] transition-opacity duration-500 group-hover:opacity-20"
      >
      </div>

      <div class="relative flex items-center justify-between">
        <span class="text-xs font-medium text-[var(--muted)]">
          Client experience
        </span>

        <span class="text-[36px] leading-none text-[var(--accent)]">“</span>
      </div>

      <blockquote
        class="relative m-0 py-8 text-[clamp(25px,3.1vw,43px)] font-medium leading-[1.3] tracking-[-0.055em] text-[var(--text)]"
      >
        {testimonials[0].quote}
      </blockquote>

      <div class="relative flex items-center gap-4">
        <div
          class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--accent)] text-[12px] font-semibold text-white"
        >
          {testimonials[0].initials}
        </div>

        <div class="flex flex-col gap-1">
          <span class="text-sm font-semibold text-[var(--text)]">
            {testimonials[0].name}
          </span>

          <span class="text-xs text-[var(--muted)]">
            {testimonials[0].role}
          </span>
        </div>
      </div>
    </article>

    <!-- Supporting testimonials -->
    <div
      class="col-span-5 grid grid-rows-2 gap-5 max-lg:col-span-6 max-md:grid-rows-none max-md:grid-cols-1"
    >
      {
        testimonials.slice(1).map((item) => (
          <article
            data-review-reveal
            class="group flex min-h-58.75 flex-col justify-between rounded-3xl bg-[var(--surface)] p-7 transition-transform duration-500 hover:-translate-y-1 max-md:min-h-65 max-md:p-6"
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--bg)] text-[11px] font-semibold text-[var(--accent)] transition-colors duration-300 group-hover:bg-[var(--accent)] group-hover:text-white">
                {item.initials}
              </div>

              <span class="text-[30px] leading-none text-[var(--accent)]">
                “
              </span>
            </div>

            <blockquote class="m-0 py-5 text-[clamp(16px,1.5vw,19px)] font-medium leading-[1.55] tracking-[-0.035em] text-[var(--text)]">
              {item.quote}
            </blockquote>

            <div class="flex flex-col gap-1">
              <span class="text-sm font-semibold text-[var(--text)]">
                {item.name}
              </span>

              <span class="text-xs text-[var(--muted)]">{item.role}</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  (() => {
    const observers = new WeakMap();

    function initReviews() {
      document.querySelectorAll(".testimonials").forEach((section) => {
        if (observers.has(section)) return;

        const items = section.querySelectorAll("[data-review-reveal]");

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          return;
        }

        items.forEach((item, index) => {
          item.style.transitionDelay = `${index * 100}ms`;

          if (item.getBoundingClientRect().top > window.innerHeight) {
            item.classList.add("opacity-0", "translate-y-8", "blur-[3px]");
          }

          item.classList.add(
            "transition-[opacity,transform,filter]",
            "duration-700",
            "ease-out",
          );
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach(({ target, isIntersecting }) => {
              target.classList.toggle("opacity-100", isIntersecting);
              target.classList.toggle("translate-y-0", isIntersecting);
              target.classList.toggle("blur-0", isIntersecting);

              target.classList.toggle("opacity-0", !isIntersecting);
              target.classList.toggle("translate-y-8", !isIntersecting);
              target.classList.toggle("blur-[3px]", !isIntersecting);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -35px 0px",
          },
        );

        items.forEach((item) => observer.observe(item));
        observers.set(section, observer);
      });
    }

    function cleanupReviews() {
      document.querySelectorAll(".testimonials").forEach((section) => {
        observers.get(section)?.disconnect();
        observers.delete(section);
      });
    }

    initReviews();

    document.addEventListener("astro:page-load", initReviews);
    document.addEventListener("astro:before-swap", cleanupReviews);
  })();
</script>
