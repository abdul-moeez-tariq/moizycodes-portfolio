<header
  class="relative z-[200] mx-auto mt-4 flex h-[60px] w-full max-w-[1600px] items-center justify-between bg-transparent px-[8%] md:px-[6%] max-md:mt-2 max-md:h-14 max-md:px-[5.5%]"
>
  <!-- Desktop Left Navigation -->
  <nav class="hidden items-center gap-7 md:flex" aria-label="Main navigation">
    <a
      href="#home"
      data-nav
      class="nav-link relative py-2 text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] transition-colors duration-300 hover:text-[var(--accent)] after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-[var(--accent)] after:transition-transform after:duration-300 hover:after:scale-x-100"
      >Home</a
    >

    <a
      href="#projects"
      data-nav
      class="nav-link relative py-2 text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] transition-colors duration-300 hover:text-[var(--accent)] after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-[var(--accent)] after:transition-transform after:duration-300 hover:after:scale-x-100"
      >Projects</a
    >

    <a
      href="#about"
      data-nav
      class="nav-link relative py-2 text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] transition-colors duration-300 hover:text-[var(--accent)] after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-[var(--accent)] after:transition-transform after:duration-300 hover:after:scale-x-100"
      >About</a
    >

    <!-- More Dropdown -->
    <div class="relative" id="more-dropdown">
      <button
        id="more-toggle"
        type="button"
        class="flex items-center gap-1.5 py-2 text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] transition-colors duration-300 hover:text-[var(--accent)]"
        aria-expanded="false"
        aria-controls="more-panel"
      >
        More
        <svg
          class="h-3 w-3 transition-transform duration-300"
          id="more-arrow"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="m3 6 5 5 5-5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>

      <div
        id="more-panel"
        class="invisible absolute left-0 top-full z-[220] mt-4 w-[340px] translate-y-2 rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-5 opacity-0 shadow-2xl shadow-black/10 transition-all duration-300"
        aria-hidden="true"
        inert
      >
        <div class="mb-4">
          <p
            class="mb-3 text-[10px] font-semibold uppercase tracking-[0.15em] text-[var(--muted)]"
          >
            Explore
          </p>

          <div class="grid grid-cols-2 gap-2">
            <a
              href="#expertise"
              data-nav
              class="dropdown-link rounded-lg px-3 py-3 text-sm text-[var(--text)] transition-colors hover:bg-[var(--surface)] hover:text-[var(--accent)]"
              >Skills <span class="ml-1 text-[var(--muted)]">↗</span></a
            >
            <a
              href="#experience"
              data-nav
              class="dropdown-link rounded-lg px-3 py-3 text-sm text-[var(--text)] transition-colors hover:bg-[var(--surface)] hover:text-[var(--accent)]"
              >Experience <span class="ml-1 text-[var(--muted)]">↗</span></a
            >
            <a
              href="#services"
              data-nav
