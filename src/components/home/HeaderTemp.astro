<script>
  const menuToggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
  const menu = document.querySelector<HTMLDivElement>("#mobile-navigation");
  const menuInner = menu?.firstElementChild as HTMLDivElement | null;
  const backdrop =
    document.querySelector<HTMLButtonElement>("#mobile-backdrop");

  const mobileLinks =
    document.querySelectorAll<HTMLAnchorElement>(".mobile-link");
  const desktopLinks =
    document.querySelectorAll<HTMLAnchorElement>(".nav-link");
  const allNavLinks =
    document.querySelectorAll<HTMLAnchorElement>("[data-nav]");

  const moreToggle = document.querySelector<HTMLButtonElement>("#more-toggle");
  const morePanel = document.querySelector<HTMLDivElement>("#more-panel");
  const moreArrow = document.querySelector<SVGElement>("#more-arrow");

  const menuFooter = menu?.querySelector(".menu-footer");
  const socialLinks = menu?.querySelectorAll(".socials a");

  let menuOpen = false;
  let dropdownOpen = false;

  function setActiveLink(href: string) {
    allNavLinks.forEach((link) => {
      const active = link.getAttribute("href") === href;

      link.classList.toggle("text-[var(--accent)]", active);
      link.classList.toggle("active", active);

      if (active) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });

    const dropdownActive = [
      ...(morePanel?.querySelectorAll<HTMLAnchorElement>("[data-nav]") ?? []),
    ].some((link) => link.getAttribute("href") === href);

    moreToggle?.classList.toggle("text-[var(--accent)]", dropdownActive);
  }

  function openMenu() {
    if (!menu || !menuInner || !backdrop || !menuToggle || menuOpen) return;

    menuOpen = true;

    menu.classList.remove("invisible", "pointer-events-none", "opacity-0");
    menu.classList.add("pointer-events-auto", "opacity-100");
    menu.setAttribute("aria-hidden", "false");
    menu.removeAttribute("inert");

    menuInner.classList.remove(
      "translate-y-[-30px]",
      "scale-[0.97]",
      "opacity-0",
    );
    menuInner.classList.add("translate-y-0", "scale-100", "opacity-100");

    backdrop.classList.remove("invisible", "opacity-0");
    backdrop.classList.add("visible", "opacity-100");
    backdrop.tabIndex = 0;

    menuToggle.classList.add("is-open");
    menuToggle.setAttribute("aria-expanded", "true");
    menuToggle.setAttribute("aria-label", "Close navigation menu");

    mobileLinks.forEach((link, index) => {
      link.classList.remove("translate-y-6", "opacity-0");
      link.classList.add("translate-y-0", "opacity-100");
      link.style.transitionDelay = `${0.08 + index * 0.06}s`;
    });

    menuFooter?.classList.remove("translate-y-5", "opacity-0");
    menuFooter?.classList.add("translate-y-0", "opacity-100");

    socialLinks?.forEach((link, index) => {
      link.classList.remove("translate-y-3", "scale-90", "opacity-0");
      link.classList.add("translate-y-0", "scale-100", "opacity-100");
      (link as HTMLElement).style.transitionDelay = `${0.34 + index * 0.06}s`;
    });

    document.body.classList.add("menu-open");
  }

  function closeMenu() {
    if (!menu || !menuInner || !backdrop || !menuToggle || !menuOpen) return;

    menuOpen = false;

    menu.classList.add("pointer-events-none", "opacity-0");
    menu.classList.remove("pointer-events-auto", "opacity-100");
    menu.setAttribute("aria-hidden", "true");
    menu.setAttribute("inert", "");

    menuInner.classList.add("translate-y-[-30px]", "scale-[0.97]", "opacity-0");
    menuInner.classList.remove("translate-y-0", "scale-100", "opacity-100");

    backdrop.classList.add("invisible", "opacity-0");
    backdrop.classList.remove("visible", "opacity-100");
    backdrop.tabIndex = -1;

    menuToggle.classList.remove("is-open");
    menuToggle.setAttribute("aria-expanded", "false");
    menuToggle.setAttribute("aria-label", "Open navigation menu");

    mobileLinks.forEach((link) => {
      link.classList.add("translate-y-6", "opacity-0");
      link.classList.remove("translate-y-0", "opacity-100");
      link.style.transitionDelay = "0s";
    });

    menuFooter?.classList.add("translate-y-5", "opacity-0");
    menuFooter?.classList.remove("translate-y-0", "opacity-100");

    socialLinks?.forEach((link) => {
      link.classList.add("translate-y-3", "scale-90", "opacity-0");
      link.classList.remove("translate-y-0", "scale-100", "opacity-100");
      (link as HTMLElement).style.transitionDelay = "0s";
    });

    document.body.classList.remove("menu-open");
  }

  function openDropdown() {
    if (!morePanel || !moreToggle || !moreArrow || dropdownOpen) return;

    dropdownOpen = true;

    morePanel.classList.remove("invisible", "opacity-0", "translate-y-2");
    morePanel.classList.add("visible", "opacity-100", "translate-y-0");
    morePanel.removeAttribute("inert");
    morePanel.setAttribute("aria-hidden", "false");

    moreToggle.setAttribute("aria-expanded", "true");
    moreArrow.classList.add("rotate-180");
  }

  function closeDropdown() {
    if (!morePanel || !moreToggle || !moreArrow || !dropdownOpen) return;

    dropdownOpen = false;

    morePanel.classList.add("invisible", "opacity-0", "translate-y-2");
    morePanel.classList.remove("visible", "opacity-100", "translate-y-0");
    morePanel.setAttribute("inert", "");
    morePanel.setAttribute("aria-hidden", "true");

    moreToggle.setAttribute("aria-expanded", "false");
    moreArrow.classList.remove("rotate-180");
  }

  menuToggle?.addEventListener("click", () => {
    menuOpen ? closeMenu() : openMenu();
  });

  backdrop?.addEventListener("click", closeMenu);

  moreToggle?.addEventListener("click", () => {
    dropdownOpen ? closeDropdown() : openDropdown();
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;

    if (
      dropdownOpen &&
      !moreToggle?.contains(target) &&
      !morePanel?.contains(target)
    ) {
      closeDropdown();
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      const href = link.getAttribute("href");

      if (href?.startsWith("#")) setActiveLink(href);

      closeMenu();
    });
  });

  allNavLinks.forEach((link) => {
    link.addEventListener("click", () => {
      const href = link.getAttribute("href");

      if (href?.startsWith("#")) setActiveLink(href);
      closeDropdown();
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
      closeDropdown();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 768) closeMenu();
  });

  // Active section detection
  const sections = document.querySelectorAll<HTMLElement>(
    "#home, #projects, #about, #expertise, #experience, #services, #contact",
  );

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

      if (visible.length) {
        setActiveLink(`#${visible[0].target.id}`);
      }
    },
    {
      rootMargin: "-15% 0px -65% 0px",
      threshold: [0, 0.25, 0.5, 0.75, 1],
    },
  );

  sections.forEach((section) => observer.observe(section));

  // Separate page active state
  function setPageActiveState() {
    const currentPath = window.location.pathname.replace(/\/$/, "") || "/";

    allNavLinks.forEach((link) => {
      const href = link.getAttribute("href");

      if (!href?.startsWith("/") || href.startsWith("/#")) return;

      const linkPath =
        new URL(href, window.location.origin).pathname.replace(/\/$/, "") ||
        "/";

      if (linkPath === currentPath) {
        setActiveLink(href);
      }
    });
  }

  setPageActiveState();

  // Keep active navigation in sync with browser history
  window.addEventListener("popstate", setPageActiveState);
  window.addEventListener("hashchange", () => {
    if (window.location.hash) setActiveLink(window.location.hash);
  });
</script>
