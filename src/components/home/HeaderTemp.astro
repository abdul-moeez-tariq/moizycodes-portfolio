      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span
        class="block h-[1.5px] w-[14px] rounded-full bg-current transition-all duration-300"
      ></span>
      <span
