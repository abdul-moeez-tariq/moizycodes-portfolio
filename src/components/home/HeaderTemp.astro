    </nav>

    <ThemeToggle />

    <!-- Original Mobile Menu Toggle -->
    <button
      class="relative hidden h-8 w-8 flex-col items-center justify-center gap-[4.5px] rounded-full border border-[var(--border)] bg-[var(--surface)] p-0 text-[var(--text)] transition-transform duration-300 hover:scale-105 max-md:flex"
