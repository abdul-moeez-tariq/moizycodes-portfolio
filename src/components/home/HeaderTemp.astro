        data-nav
        class="nav-link relative py-2 text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] transition-colors duration-300 hover:text-[var(--accent)] after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-[var(--accent)] after:transition-transform after:duration-300 hover:after:scale-x-100"
        >Contact</a
